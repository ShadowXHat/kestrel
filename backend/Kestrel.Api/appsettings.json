{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/kestrel.db",
    "EventsConnection": "Data Source=data/kestrel.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "AllowedHosts": "*",
  "KestrelApp": {
    "AllowNetworkBinding": false,
    "RateLimit": {
      "Auth": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    },
    "Identity": {
      "Password": {
        "RequiredLength": 12,
        "RequireDigit": true,
        "RequireUppercase": true,
        "RequireLowercase": true,
        "RequireNonAlphanumeric": true
      },
      "Lockout": {
        "MaxFailedAccessAttempts": 5,
        "DurationMinutes": 15
      }
    },
    "Seed": {
      "AdminUsername": "admin",
      "AdminPassword": ""
    },
    "Ingest": {
      "MaxUploadBytes": 2147483648,
      "JobTimeoutMinutes": 30,
      "BatchSize": 1000,
      "MaxRecordsPerJob": 5000000,
      "MaxPerRecordErrorsRetained": 50,
      "TempDirectory": "data/uploads-tmp"
    }
  },
  "Sigma": {
    "RulePackPath": "rules",
    "SpecVersion": "1.0"
  },
  "Attack": {
    "StixFilePath": "data/enterprise-attack.json"
  }
}

